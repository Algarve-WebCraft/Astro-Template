---
import "../styles/global.css";
import "../styles/dark-mode.css";
import Head from "../components/base/Head.astro";
import Header from "../components/base/Header.astro";
import Footer from "../components/base/Footer.astro";

const { bodyClass, pageTitle, pageDescription } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head pageTitle={pageTitle} pageDescription={pageDescription} />
  </head>

  <body class={bodyClass}>
    <Header transition:persist />
    <slot />
    <Footer />
  </body>
</html>

<script>
  import "../scripts/global.js";
  import "../scripts/darkMode.js";
</script>
